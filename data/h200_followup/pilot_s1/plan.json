{
 "session_id": "pilot_s1",
 "partition": "pilot",
 "order_seed": 1,
 "notes": "validation pilot; order shuffled; resnet ord/dil5/noinstr share a job_id (same partition group)",
 "sensors": {
  "scope_range": "V10",
  "scope_raw": "all",
  "scope_hires": "every:60:1:20",
  "dcgm": true
 },
 "runs": [
  {
   "label": "whisper_serve",
   "class_label": "ml_inference",
   "family": "whisper",
   "kind": "serve",
   "argv": [
    "--model",
    "whisper",
    "--schedule",
    "60:1,30:0,60:3",
    "--seed",
    "0"
   ],
   "timeout_s": 900
  },
  {
   "label": "render_pathtrace",
   "class_label": "other",
   "family": "render",
   "kind": "nonml",
   "workload": "render",
   "argv": [
    "--duration",
    "120"
   ],
   "timeout_s": 300
  },
  {
   "label": "idle",
   "class_label": "other",
   "family": "idle",
   "kind": "nonml",
   "workload": "idle",
   "argv": [
    "--duration",
    "60"
   ],
   "timeout_s": 200
  },
  {
   "label": "cufft",
   "class_label": "other",
   "family": "cufft",
   "kind": "nonml",
   "workload": "cufft",
   "argv": [
    "--duration",
    "120"
   ],
   "timeout_s": 300
  },
  {
   "label": "phi3_serve",
   "class_label": "ml_inference",
   "family": "phi3",
   "kind": "serve",
   "argv": [
    "--model",
    "phi3",
    "--schedule",
    "60:0.1,30:0,60:0.3,30:0.05",
    "--seed",
    "0"
   ],
   "timeout_s": 900
  },
  {
   "label": "resnet18_cifar10_dil5",
   "class_label": "ml_training",
   "family": "resnet",
   "kind": "train",
   "argv": [
    "--family",
    "resnet",
    "--mode",
    "diluted",
    "--dilution",
    "5",
    "--duration",
    "300",
    "--seed",
    "0"
   ],
   "timeout_s": 900,
   "attack": {
    "strategy": "diluted_updates",
    "dilution": 5,
    "matched_control": "resnet18_cifar10_ord"
   },
   "job_id": "pilot_s1-resnet_pair"
  },
  {
   "label": "bert_sst2_ord",
   "class_label": "ml_training",
   "family": "bert",
   "kind": "train",
   "argv": [
    "--family",
    "bert",
    "--duration",
    "300",
    "--seed",
    "0"
   ],
   "timeout_s": 900
  },
  {
   "label": "resnet18_cifar10_ord_noinstr",
   "class_label": "ml_training",
   "family": "resnet",
   "kind": "train",
   "argv": [
    "--family",
    "resnet",
    "--duration",
    "300",
    "--seed",
    "0",
    "--gpu-marks",
    "0"
   ],
   "timeout_s": 900,
   "sensors": false,
   "purpose": "instrumentation overhead control",
   "job_id": "pilot_s1-resnet_pair"
  },
  {
   "label": "mlp_cifar10_ord",
   "class_label": "ml_training",
   "family": "mlp",
   "kind": "train",
   "argv": [
    "--family",
    "mlp",
    "--duration",
    "180",
    "--seed",
    "0",
    "--gpu-marks",
    "1"
   ],
   "timeout_s": 600
  },
  {
   "label": "resnet18_cifar10_ord",
   "class_label": "ml_training",
   "family": "resnet",
   "kind": "train",
   "argv": [
    "--family",
    "resnet",
    "--duration",
    "300",
    "--seed",
    "0"
   ],
   "timeout_s": 900,
   "job_id": "pilot_s1-resnet_pair"
  }
 ]
}